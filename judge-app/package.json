{
  "name": "tkd-poomsae-scorer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_UNSTABLE_HEADLESS=1 expo start --go --lan -c",
    "start:dev-client": "EXPO_UNSTABLE_HEADLESS=1 expo start --dev-client --lan -c",
    "start:mock": "EXPO_UNSTABLE_HEADLESS=1 EXPO_PUBLIC_USE_MOCK_BACKEND=1 expo start --dev-client --lan -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "detox test --configuration android.emu.debug",
    "test:e2e:build": "detox build --configuration android.emu.debug",
    "test:e2e:mock": "EXPO_PUBLIC_USE_MOCK_BACKEND=1 detox test --configuration android.emu.debug",
    "start:tunnel": "EXPO_UNSTABLE_HEADLESS=1 expo start --dev-client --tunnel",
    "start:go": "EXPO_UNSTABLE_HEADLESS=1 expo start --go --lan -c",
    "start:go:tunnel": "EXPO_UNSTABLE_HEADLESS=1 expo start --go --tunnel",
    "start:phone": "lsof -ti tcp:8081 | xargs -r kill -9; REACT_NATIVE_PACKAGER_HOSTNAME=$(ip route get 1.1.1.1 | awk '{print $7; exit}') EXPO_UNSTABLE_HEADLESS=1 expo start --go --lan --port 8081 -c",
    "build:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "expo": "^55.0.8",
    "expo-camera": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-device": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.8",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.9",
    "expo-sqlite": "~55.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.47.0",
    "eslint": "^9.30.1",
    "eslint-config-expo": "^55.0.0",
    "jest": "^30.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "jest"
      ]
    }
  }
}
