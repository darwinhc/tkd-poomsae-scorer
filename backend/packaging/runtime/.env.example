# =====================================
# Poomsae Server - Local configuration
# =====================================

# Environment
TKD_APP_NAME=Poomsae Local Server
TKD_ENVIRONMENT=local
TKD_PROTOCOL_VERSION=v1
TKD_TOURNAMENT_ID=tkd-poomsae-local

# Network (server)
TKD_HOST=0.0.0.0
TKD_PORT=8080

# Public URL for QR codes (must be reachable from the phones)
# Example: http://192.168.1.20:8080
TKD_PUBLIC_BASE_URL=http://192.168.1.20:8080
TKD_BASE_URL=http://127.0.0.1:8080
TKD_QR_USE_SERVER_IP=false
TKD_QR_SERVER_IP_OVERRIDE=

# Local persistence
TKD_DATABASE_URL=sqlite:///./data/tkd_scorer.db
TKD_DATA_DIR=data
TKD_LOGS_DIR=logs
TKD_LOG_FILE_NAME=tkd_server.log
TKD_LOG_LEVEL=INFO

# Admin panel and TV scoreboard language: en (English, default) or es (Spanish)
TKD_UI_LANGUAGE=en

# Security (you MUST change these)
TKD_JWT_SECRET_KEY=CHANGE_TO_A_VERY_LONG_SECRET
TKD_JWT_ALGORITHM=HS256
TKD_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
TKD_ADMIN_BASE_PATH=/secure-panel-change-me

# Local admin policies
TKD_ADMIN_SECURITY_FAIL_FAST=true
TKD_ADMIN_MIN_PASSWORD_LENGTH=10
TKD_ADMIN_IP_ALLOWLIST=0.0.0.0/0,::/0
TKD_ADMIN_TRUST_PROXY_HEADERS=false
TKD_ADMIN_AUTH_COOKIE_NAME=tkd_admin_auth
TKD_ADMIN_AUTH_COOKIE_TTL_SECONDS=86400
TKD_ADMIN_COOKIE_SECURE=false
TKD_ADMIN_LOGIN_MAX_ATTEMPTS=5
TKD_ADMIN_LOGIN_WINDOW_SECONDS=300
TKD_ADMIN_LOGIN_LOCKOUT_SECONDS=300

# Tokens and credentials
TKD_BOOTSTRAP_TOKEN_TTL_SECONDS=180
TKD_OPERATIONAL_TOKEN_TTL_SECONDS=2592000
TKD_STATION_CREDENTIAL_TTL_SECONDS=28800
TKD_STATION_CREDENTIAL_ROTATION_SECONDS=20
TKD_STATION_CREDENTIAL_CREATE_LENGTH=4
TKD_STATION_CREDENTIAL_ROTATE_LENGTH=6

# Required YAML catalog
TKD_REQUIRE_POOMSAE_CATALOG_FILE=true
TKD_POOMSAE_CATALOG_PATH=config/poomsae_categories.yaml

# Judging parameters
TKD_HISTORY_RETENTION_MATCHES=100
TKD_HISTORY_DELETE_BULK_SCAN_LIMIT=100000
TKD_MATCH_QUERY_LIMIT_ACTIVE_LOOKUP=50
TKD_MATCH_QUERY_LIMIT_SCOREBOARD=300
TKD_CREATE_MATCH_DEFAULT_STARTING_SCORE=4.0
TKD_JUDGE_DEFAULT_ROUNDS=2
TKD_JUDGE_DEFAULT_STARTING_SCORE=4.0
TKD_JUDGE_PRESENTATION_CATEGORY_START_SCORE=2.0
TKD_JUDGE_ACTION_VALUE_1=0.1
TKD_JUDGE_ACTION_VALUE_2=0.3
TKD_JUDGE_OFFICIAL_COUNTS=3,5,7
TKD_WEBSOCKET_PING_INTERVAL_SECONDS=20
TKD_WEBSOCKET_STALE_TIMEOUT_SECONDS=60
TKD_LIVE_MIN_WIDTH_PX=768
